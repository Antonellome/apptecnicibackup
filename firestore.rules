rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // I tecnici autenticati possono leggere tutti i dati
    // (necessario per i menu a tendina)
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // I tecnici autenticati possono scrivere nella collezione 'rapportini'
    // (necessario per salvare i nuovi report)
    match /rapportini/{rapportinoId} {
      allow write: if request.auth != null;
    }

    // Regole specifiche per la collezione 'notifications'
    match /notifications/{notificationId} {
      // Permetti la lettura a tutti gli utenti autenticati. 
      // Firestore filtrerà i documenti in base alla query del client.
      allow read: if request.auth != null;
      
      // Permetti la creazione (invio da Master Office) a utenti autenticati
      allow create: if request.auth != null;
      
      // Permetti aggiornamento (per isRead) ed eliminazione solo se l'utente è il destinatario
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.recipientId;
    }
  }
}