rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This function gets the user's tecnicoId from their profile document in the 'utenti' collection
    function getTecnicoId(userId) {
      return get(/databases/$(database)/documents/utenti/$(userId)).data.tecnicoId;
    }

    // Allow read access to master data collections for any authenticated user
    match /anagrafiche/{docId} { allow read: if request.auth != null; }
    match /tariffe_locali/{docId} { allow read: if request.auth != null; }
    match /navi/{docId} { allow read: if request.auth != null; }
    match /luoghi/{docId} { allow read: if request.auth != null; }
    match /veicoli/{docId} { allow read: if request.auth != null; }
    match /tipiGiornata/{docId} { allow read: if request.auth != null; }
    match /tecnici/{docId} { allow read: if request.auth != null; }
    
    // User can read/write their own profile
    match /utenti/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for 'rapportini'
    match /rapportini/{rapportinoId} {
      // A user can read a report if their tecnicoId is in the 'presenze' array.
      // This single check covers both creator and participant roles.
      allow read: if request.auth != null && getTecnicoId(request.auth.uid) in resource.data.presenze;

      // A user can create a report if their tecnicoId is in the 'presenze' array of the NEW document.
      allow create: if request.auth != null && getTecnicoId(request.auth.uid) in request.resource.data.presenze;

      // Only the original creator (tecnicoId) can update or delete the report.
      allow update, delete: if request.auth != null && getTecnicoId(request.auth.uid) == resource.data.tecnicoId;
    }

    // Fallback deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
